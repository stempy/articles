<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}{{#if title_suffix}} - {{title_suffix}}{{/if}}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">

    {{#each css_files}}
    <link rel="stylesheet" href="{{this}}">
    {{/each}}

    {{#if accent_color}}
    <style>
        /* Dynamic accent color for articles */
        .article-title {
            color: var(--accent-{{accent_color}});
        }

        .article-content a {
            color: var(--accent-{{accent_color}});
        }

        .article-content a:hover {
            border-bottom-color: var(--accent-{{accent_color}});
        }

        .article-content h2 {
            color: var(--accent-{{accent_color}});
        }

        .article-content th {
            color: var(--accent-{{accent_color}});
        }

        .back-link {
            color: var(--accent-{{accent_color}});
        }
    </style>
    {{/if}}
</head>
<body>
    <div class="container">
        {{> content}}
    </div>

    {{#each js_files}}
    <script src="{{this}}"></script>
    {{/each}}
</body>
</html>
