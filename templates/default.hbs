{{#> base}}
<header>
    <div class="title-wrapper">
        <p class="subtitle">{{subtitle}}</p>
        <h1>{{{header_title}}}</h1>
    </div>
    <p class="intro">
        {{intro}}
    </p>
</header>

<main>
    {{{body_content}}}
    <section class="article-section">
        <div class="section-heading">
            <span class="section-label">{{section_label}}</span>
            <h2>{{section_title}}</h2>
        </div>

        <div class="card-grid article-grid">
            {{#each articles}}
            <article class="card article-card" style="--card-accent: var(--accent-{{accent_color}});">
                <div class="article-meta">
                    <span class="article-status {{status_class}}">{{status}}</span>
                    <span>Updated {{date}}</span>
                </div>
                <h3 class="article-title">{{title}}</h3>
                <p class="article-summary">
                    {{summary}}
                </p>
                <a class="article-link" href="{{link}}">Explore</a>
            </article>
            {{/each}}
        </div>
    </section>
</main>

<footer>
    <p class="footer-text">{{{footer_text}}}</p>
</footer>
{{/base}}
