{{!-- Determine which gallery data to use --}}
{{!-- Priority: items (from data="key") > page[id] (from id="key") > page.gallery (legacy) --}}
{{#if items}}
{{!-- Modern usage with data="galleryname" parameter --}}
{{#if layout}}
<figure class="image-gallery {{layout}} {{class}}">
{{else}}
{{#if (eq (length items) 2)}}
<figure class="image-gallery half {{class}}">
{{else}}
{{#if (eq (length items) 1)}}
<figure class="image-gallery {{class}}">
{{else}}
<figure class="image-gallery third {{class}}">
{{/if}}
{{/if}}
{{/if}}
{{#if caption}}
    <figcaption class="gallery-caption">{{caption}}</figcaption>
{{/if}}
<div class="gallery-grid">
{{#each items}}
    <div class="gallery-item">
        <img src="{{image_path}}" alt="{{#if alt}}{{alt}}{{else}}{{title}}{{/if}}" class="gallery-thumbnail" data-full="{{image_path}}"{{#if title}} data-caption="{{title}}"{{/if}}>
    </div>
{{/each}}
</div>
</figure>
{{else}}
{{!-- Legacy usage with id="galleryname" or no parameter (uses page.gallery) --}}
{{!-- Try to get gallery by id from page[id], otherwise fall back to page.gallery --}}
{{#if id}}
{{#with (lookup page id)}}
{{#if layout}}
<figure class="image-gallery {{../layout}} {{../class}}">
{{else}}
{{#if (eq (length this) 2)}}
<figure class="image-gallery half {{../class}}">
{{else}}
{{#if (eq (length this) 1)}}
<figure class="image-gallery {{../class}}">
{{else}}
<figure class="image-gallery third {{../class}}">
{{/if}}
{{/if}}
{{/if}}
{{#if ../caption}}
    <figcaption class="gallery-caption">{{../caption}}</figcaption>
{{/if}}
<div class="gallery-grid">
{{#each this}}
    <div class="gallery-item">
        <img src="{{image_path}}" alt="{{#if alt}}{{alt}}{{else}}{{title}}{{/if}}" class="gallery-thumbnail" data-full="{{image_path}}"{{#if title}} data-caption="{{title}}"{{/if}}>
    </div>
{{/each}}
</div>
</figure>
{{/with}}
{{else}}
{{!-- No id parameter, use page.gallery --}}
{{#if layout}}
<figure class="image-gallery {{layout}} {{class}}">
{{else}}
{{#if (eq (length page.gallery) 2)}}
<figure class="image-gallery half {{class}}">
{{else}}
{{#if (eq (length page.gallery) 1)}}
<figure class="image-gallery {{class}}">
{{else}}
<figure class="image-gallery third {{class}}">
{{/if}}
{{/if}}
{{/if}}
{{#if caption}}
    <figcaption class="gallery-caption">{{caption}}</figcaption>
{{/if}}
<div class="gallery-grid">
{{#each page.gallery}}
    <div class="gallery-item">
        <img src="{{image_path}}" alt="{{#if alt}}{{alt}}{{else}}{{title}}{{/if}}" class="gallery-thumbnail" data-full="{{image_path}}"{{#if title}} data-caption="{{title}}"{{/if}}>
    </div>
{{/each}}
</div>
</figure>
{{/if}}
{{/if}}
